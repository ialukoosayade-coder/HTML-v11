	},
	"tokenColors": [
		{
			"scope": [
				"comment"
			],
			"settings": {
				"foreground": "#8A9AA4",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"keyword",
				"storage"
			],
			"settings": {
				"foreground": "#2F6B93"
			}
		},
		{
			"scope": [
				"string"
			],
			"settings": {
				"foreground": "#8A6B2E"
			}
		},
		{
			"scope": [
				"entity.name.function",
				"support.function"
			],
			"settings": {
				"foreground": "#1F7A8C"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"support.type",
				"support.class"
			],
			"settings": {
				"foreground": "#4A6B8A"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.language",
				"variable.other.constant"
			],
			"settings": {
				"foreground": "#B06A3E"
			}
		},
		{
			"scope": [
				"variable"
			],
			"settings": {
				"foreground": "#3A4650"
			}
		},
		{
			"scope": [
				"variable.parameter"
			],
			"settings": {
				"foreground": "#5D6E78"
			}
		},
		{
			"scope": [
				"variable.other.property",
				"support.variable.property"
			],
			"settings": {
				"foreground": "#2F7A8C"
			}
		},
		{
			"scope": [
				"keyword.operator"
			],
			"settings": {
				"foreground": "#6B7C88"
			}
		},
		{
			"scope": [
				"punctuation"
			],
			"settings": {
				"foreground": "#8A9AA4"
			}
		},
		{
			"scope": [
				"entity.name.tag"
			],
			"settings": {
				"foreground": "#2F6B93"
			}
		},
		{
			"scope": [
				"entity.other.attribute-name"
			],
			"settings": {
				"foreground": "#A8802E"
			}
		},
		{
			"scope": [
				"string.regexp"
			],
			"settings": {
				"foreground": "#8A6B2E"
			}
		},
		{
			"scope": [
				"constant.character.escape"
			],
			"settings": {
				"foreground": "#A8802E"
			}
		},
		{
			"scope": [
				"markup.heading"
			],
			"settings": {
				"foreground": "#22303A",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.bold"
			],
			"settings": {
				"foreground": "#22303A",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.italic"
			],
			"settings": {
				"foreground": "#22303A",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"invalid"
			],
			"settings": {
				"foreground": "#B85C5C"
			}
		},
		{
			"scope": "token.info-token",
			"settings": {
				"foreground": "#316BCD"
			}
		},
		{
			"scope": "token.warn-token",
			"settings": {
				"foreground": "#CD9731"
			}
		},
		{
			"scope": "token.error-token",
			"settings": {
				"foreground": "#CD3131"
			}
		},
		{
			"scope": "token.debug-token",
			"settings": {
				"foreground": "#800080"
			}
		}
	]
}